# Hosted image provider. Vercel AI Gateway is the default and authenticates
# with the short-lived Vercel OIDC token available to each Function request.
AI_IMAGE_PROVIDER=gateway
AI_GATEWAY_IMAGE_MODEL=google/gemini-3.1-flash-image
AI_GATEWAY_PREFLIGHT_MODEL=google/gemini-3.1-flash-lite
# Local Next.js only: refresh this short-lived token with `vercel env pull`.
# Vercel deployments inject request-scoped OIDC automatically.
VERCEL_OIDC_TOKEN=

# Optional direct Gemini alternative. Set AI_IMAGE_PROVIDER=gemini and keep
# this credential server-side; it must never use a NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_PREFLIGHT_MODEL=gemini-3.1-flash-lite

# Protected release canary. Use one random secret in the deployment and the
# local runner. Non-Git deployments must set a deliberate artifact ID.
BOOTH_CANARY_SECRET=
BOOTH_RELEASE_ARTIFACT_ID=

# Never guess these values. scripts/run-image-canary.mjs prints them only
# after the exact deployed build passes generation and decoded-pixel checks
# in under 42 seconds. The proof expires after seven days.
AI_IMAGE_PROVIDER_VERIFIED=
AI_IMAGE_PROVIDER_CANARY_MS=
AI_IMAGE_PROVIDER_VERIFIED_ARTIFACT_SHA256=
AI_IMAGE_PROVIDER_VERIFIED_CONFIG_SHA256=
AI_IMAGE_PROVIDER_VERIFIED_AT=
AI_IMAGE_PROVIDER_VERIFIED_EXPIRES_AT=

# Optional override for the live World Cup scoreboard JSON endpoint.
WORLD_CUP_SCOREBOARD_URL=

# Legacy optional code retained for compatibility with unused card variants.
NEXT_PUBLIC_DEFAULT_CODE=GETCAPPED
