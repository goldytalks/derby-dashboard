# Preferred image provider. auto uses OpenAI first, then Gemini, then mock.
AI_IMAGE_PROVIDER=auto

# GPT Image 2 edit path.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_IMAGE_QUALITY=medium

# Optional Gemini fallback.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Optional override for the live World Cup scoreboard JSON endpoint.
WORLD_CUP_SCOREBOARD_URL=

# Legacy optional code retained for compatibility with older card templates.
NEXT_PUBLIC_DEFAULT_CODE=GETCAPPED

# Planned hosted provider adapter. These are not required by the local Codex Mini-App.
# Keep them server-side only. See docs/HOSTED_RUNTIME_PLAN.md.
HF_CREDENTIALS=
HF_IMAGE_ENDPOINT=
HF_WEBHOOK_SECRET=
PUBLIC_BASE_URL=
